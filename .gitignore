# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# === Cross-stack ===
.DS_Store
*.pem
.env*
.vercel

# Stray Next.js build output at root (in case anyone runs `npm run dev` outside /frontend/)
/.next/
/out/
/node_modules/

# === Frontend (Next.js / Node) ===
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# === Backend (.NET) ===
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/*.suo
backend/**/.vs/
backend/**/TestResults/
backend/**/coverage/
backend/**/*.dll
backend/**/*.pdb
backend/**/launchSettings.local.json
backend/**/appsettings.Local.json
backend/**/appsettings.Development.local.json
backend/**/local.settings.json
backend/**/*.dll.config

# === IDE ===
.idea/
*.swp

# === Claude Code session-managed config ===
# settings.json is rewritten by the session (model, permissions, etc.) on
# every run — it is operator-local, not shared project config. Tracking it
# made it perpetually dirty and blocked git checkout/rebase. The SHARED
# Claude config lives in CLAUDE.md, .claude/agents/, and .claude/commands/
# (all still tracked). See .claude/agents/README.md "Session config".
.claude/settings.json
.claude/settings.local.json
