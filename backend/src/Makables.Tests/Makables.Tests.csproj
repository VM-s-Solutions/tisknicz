<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Makables.Core.Domain\Makables.Core.Domain.csproj" />
    <ProjectReference Include="..\Makables.Core.AppServices\Makables.Core.AppServices.csproj" />
    <ProjectReference Include="..\Makables.Config\Makables.Config.csproj" />
    <ProjectReference Include="..\Makables.TestUtilities\Makables.TestUtilities.csproj" />
    <ProjectReference Include="..\Makables.Infra.Common\Makables.Infra.Common.csproj" />
    <ProjectReference Include="..\Makables.Infra.Database\Makables.Infra.Database.csproj" />
    <ProjectReference Include="..\Makables.Infra.Clients\Makables.Infra.Clients.csproj" />
    <ProjectReference Include="..\Makables.Infra.Azure.Storage.Blobs\Makables.Infra.Azure.Storage.Blobs.csproj" />
    <ProjectReference Include="..\Makables.Infra.PdfRendering\Makables.Infra.PdfRendering.csproj" />
    <!-- T-0066: ComgateWebhookIpAllowlistAttribute lives on Web.Public.
         The unit tests construct ComgateWebhookIpAllowlistFilter directly
         with a synthetic AuthorizationFilterContext, so the reference
         keeps Web.Public's filter class reachable from the unit project. -->
    <ProjectReference Include="..\Makables.Web.Public\Makables.Web.Public.csproj" />
    <!-- T-0088: the invoice-download actions are controller-direct (ADR
         0014 handler-free read paths), so their unit tests construct the
         OrdersController on each host directly with NSubstitute mocks +
         a DefaultHttpContext — same shape as the Web.Public filter tests
         above. The references keep both controllers reachable without
         booting either host. -->
    <ProjectReference Include="..\Makables.Web.Customer\Makables.Web.Customer.csproj" />
    <ProjectReference Include="..\Makables.Web.Maker\Makables.Web.Maker.csproj" />
    <!-- T-0069: GenerateInvoiceFunction lives on Makables.Functions. The
         unit tests construct it directly with NSubstitute mocks of
         IOutboxConsumerRepository + ISender — same shape as the existing
         SendEmailHandler tests. The reference keeps the Function class
         reachable from the unit project without bringing the Functions
         worker runtime into the test discovery. -->
    <ProjectReference Include="..\Makables.Functions\Makables.Functions.csproj" />
  </ItemGroup>

</Project>
