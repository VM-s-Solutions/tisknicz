<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cap parallelism at 2 — Testcontainers Postgres has a finite
         connection pool and the shared [Collection] already serialises
         same-collection tests; this bounds cross-collection concurrency. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Makables.Web.Customer\Makables.Web.Customer.csproj" />
    <ProjectReference Include="..\Makables.Web.Maker\Makables.Web.Maker.csproj" />
    <ProjectReference Include="..\Makables.Web.Admin\Makables.Web.Admin.csproj" />
    <ProjectReference Include="..\Makables.Web.Public\Makables.Web.Public.csproj" />
    <ProjectReference Include="..\Makables.TestUtilities\Makables.TestUtilities.csproj" />
    <!-- T-0069: integration test for the outbox routing branch wires the
         real OutboxConsumerRepository (Infra.Database) against a fake
         IOutboxQueuePublisher, dispatched through the real OutboxDispatcher
         (Core.AppServices) so the EF entity round-trip + classifier +
         publisher branch all line up against the canonical event-type
         string. The Web.* hosts already transitively reference all three
         projects but the explicit edges keep the dependency graph honest. -->
    <ProjectReference Include="..\Makables.Core.AppServices\Makables.Core.AppServices.csproj" />
    <ProjectReference Include="..\Makables.Infra.Database\Makables.Infra.Database.csproj" />
  </ItemGroup>

</Project>
